# ==============================================================
# Adaptive ML Experiment Agent — Environment Variable Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------------
# PostgreSQL connection string (local installation)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example for default local PostgreSQL with pgAdmin:
#   DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments
# ------------------------------------------------------------------
DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments

# ------------------------------------------------------------------
# Ollama LLM server (used from Phase 4 onward)
# OLLAMA_BASE_URL: URL where Ollama is running (default: localhost)
# OLLAMA_MODEL:    Qwen model tag to use (can be changed without code changes)
# ------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
