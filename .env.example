# ==============================================================
# Adaptive ML Experiment Agent — Environment Variable Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------------
# PostgreSQL connection string (local installation)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example for default local PostgreSQL with pgAdmin:
#   DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments
# ------------------------------------------------------------------
DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments

# ------------------------------------------------------------------
# LLM — the Planner and Recommender agents call an LLM through one client
# interface; anomaly explanations are template-based.
#
# LLM_PROVIDER picks the backend: "groq" (default) or "gemini". Only the
# selected provider's API key is needed.
# ------------------------------------------------------------------
LLM_PROVIDER=groq

# --- Groq Cloud (openai/gpt-oss-120b, strict JSON-schema structured output) ---
# GROQ_API_KEY is required when LLM_PROVIDER=groq — free key at https://console.groq.com
#   (the free tier caps gpt-oss-120b at ~8000 tokens/minute; upgrading to the
#    Dev tier, also free, removes that. Or set GROQ_MODEL=llama-3.3-70b-versatile.)
# GROQ_BASE_URL / GROQ_MODEL have sensible defaults — only set to override.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (responseSchema structured output) ---
# GEMINI_API_KEY is required when LLM_PROVIDER=gemini — key at https://aistudio.google.com/apikey
# GEMINI_MODEL is any model your key can access (default: gemini-3.8-flash).
# GEMINI_BASE_URL has a sensible default — only set to override.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------
# Adaptive loop (Phase 5) - optional
#   MAX_ADAPTIVE_CYCLES: safety cap on cycles per POST /run-cycle. The
#   Recommender normally decides when to stop; this prevents an infinite
#   in-graph loop if it never concludes. Requirement 11 expects 2-3.
# ------------------------------------------------------------------
MAX_ADAPTIVE_CYCLES=6

# ------------------------------------------------------------------
# FastAPI backend (Phase 6) - all optional, sensible defaults shown
#   CORS_ORIGINS: "*" for local dev, or a comma-separated origin list
#   API_HOST / API_PORT: what `python -m backend.api.main` binds to
# ------------------------------------------------------------------
CORS_ORIGINS=*
API_HOST=127.0.0.1
API_PORT=8000
