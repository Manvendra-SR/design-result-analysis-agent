# ==============================================================
# Adaptive ML Experiment Agent — Environment Variable Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------------
# PostgreSQL connection string (local installation)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example for default local PostgreSQL with pgAdmin:
#   DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments
# ------------------------------------------------------------------
DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments

# ------------------------------------------------------------------
# Ollama LLM server (used from Phase 4 onward)
# OLLAMA_BASE_URL: URL where Ollama is running (default: localhost)
# OLLAMA_MODEL:    Qwen model tag to use (can be changed without code changes)
# ------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------------
# Adaptive loop (Phase 5) - optional
#   MAX_ADAPTIVE_CYCLES: safety cap on cycles per POST /run-cycle. The
#   Recommender normally decides when to stop; this prevents an infinite
#   in-graph loop if it never concludes. Requirement 11 expects 2-3.
# ------------------------------------------------------------------
MAX_ADAPTIVE_CYCLES=6

# ------------------------------------------------------------------
# FastAPI backend (Phase 6) - all optional, sensible defaults shown
#   CORS_ORIGINS: "*" for local dev, or a comma-separated origin list
#   API_HOST / API_PORT: what `python -m backend.api.main` binds to
# ------------------------------------------------------------------
CORS_ORIGINS=*
API_HOST=127.0.0.1
API_PORT=8000
