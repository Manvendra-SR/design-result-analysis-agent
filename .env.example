# ==============================================================
# Adaptive ML Experiment Agent — Environment Variable Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# ------------------------------------------------------------------
DATABASE_URL=postgresql://mluser:yourpassword@localhost:5432/mlexperiments

# ------------------------------------------------------------------
# LLM — Groq Cloud (strict JSON-schema structured output)
# GROQ_API_KEY is required — free key at https://console.groq.com
#   (the free tier caps gpt-oss-120b at ~8000 tokens/minute; the client
#    waits out 429s using Retry-After.)
# GROQ_BASE_URL / GROQ_MODEL have sensible defaults — only set to override.
# ------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------
# Investigation loop - optional
#   MAX_ROUNDS: rounds of experiments (the plan + rounds the Recommender
#               chooses to refine). The last round always concludes.
#   N_SEEDS:    training runs per random forest / MLP candidate (the linear
#               model and the decision tree are seed-independent: they run once).
# ------------------------------------------------------------------
MAX_ROUNDS=3
N_SEEDS=3

# ------------------------------------------------------------------
# FastAPI backend - optional
#   CORS_ORIGINS: "*" for local dev, or a comma-separated origin list
#   API_HOST / API_PORT: what `python -m backend.api.main` binds to
# ------------------------------------------------------------------
CORS_ORIGINS=*
API_HOST=127.0.0.1
API_PORT=8000
